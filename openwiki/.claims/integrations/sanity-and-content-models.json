  "claims": [
    {
      "id": "claim_3a9c67e18ed14805872274ab68945da5",
      "statement": "`src/lib/sanity/config.ts` centralizes the Sanity deployment constants used by the read and write paths, including the fixed project id, dataset, pinned API version, CDN query host, mutate host, image host, site origin, and a conservative GET URL limit below Sanity's documented ceiling.",
      "evidence": [
        {
          "resource": "repo://src/lib/sanity/config.ts#L1-L61",
          "version": "repo-lines-v1:sha256:9e92a47af8775efa05c48a67abcfb539ab6764c647705a3805b986993e21cad5:"
        },
        {
          "resource": "repo://src/lib/sanity/config.ts#L23-L44",
          "version": "repo-lines-v1:sha256:5eb35becd6656afdc0d9a7231bc9e6a4f4d63141d7e50fcd384498c953ff7f9b:"
        }
      ]
    },
    {
      "id": "claim_32c27345dbab4dc08d58a72776eb75b0",
      "statement": "`SITE_ORIGIN` is treated as the canonical public origin for permanent URLs, canonicals, Open Graph images, and sitemap entries, so it is defined as a constant rather than as environment-driven configuration.",
      "evidence": [
        {
          "resource": "repo://src/lib/sanity/config.ts#L48-L66",
          "version": "repo-lines-v1:sha256:f97c452bea33a0cb91a50b856c859effd6ef6f2857a58d7ab26e7b746863f59e:"
        }
      ]
    },
    {
      "id": "claim_d4078bc7505648e5937352f32c4a5f52",
      "statement": "`src/lib/sanity/projection-map.ts` makes the alias-to-source projection map the source of truth for episode reads, and `project()` converts that map into GROQ object-projection syntax instead of retyping field wiring at each query site.",
      "evidence": [
        {
          "resource": "repo://src/lib/sanity/projection-map.ts#L1-L29",
          "version": "repo-lines-v1:sha256:ed4a8886cda5b8fc5fddd01bdc120ce1669af74493919e5042bd1ae743eabd43:"
        },
        {
          "resource": "repo://src/lib/sanity/projection-map.ts#L111-L126",
          "version": "repo-lines-v1:sha256:d89052accdb0d70565d187a1a205f8b2ddf2011eefe3df34cfa8e160740f7e18:"
        }
      ]
    },
    {
      "id": "claim_19fede51d97a442fb5ce0cfc7e25002e",
      "statement": "The episode projection deliberately keeps some fields as whole objects or dereferenced subprojections while projecting image fields to `asset._ref`, because the read path needs the slug object, dereferenced topic names, and raw image refs rather than wider document shapes.",
      "evidence": [
        {
          "resource": "repo://src/lib/sanity/projection-map.ts#L14-L29",
          "version": "repo-lines-v1:sha256:8eeb8ab680eda5b1e7e9696e192f29a03d663807f84b9541532eb0a04711369e:"
        },
        {
          "resource": "repo://src/lib/sanity/projection-map.ts#L30-L50",
          "version": "repo-lines-v1:sha256:322b21f9897ff577eb24b0153a088756cbfda48ea174e2f9a52e761640553129:"
        }
      ]
    },
    {
      "id": "claim_2502952dc25148739922a02ea5983cf4",
      "statement": "The list projection is intentionally narrower than the full episode projection, excluding fields such as `description`, `searchText`, `guestBio`, `podbeanUrl`, `_id`, `guid`, and `slugFrozenAt` to keep the catalogue payload small and stable.",
      "evidence": [
        {
          "resource": "repo://src/lib/sanity/projection-map.test.ts#L171-L219",
          "version": "repo-lines-v1:sha256:ed2564ad1d08c6ee3e9db72d19ce0452004d6c751605eb6c9b5d41e86008e061:"
        },
        {
          "resource": "repo://src/lib/sanity/projection-map.ts#L52-L108",
          "version": "repo-lines-v1:sha256:c4b303c5a860529452dc67c97341ea628d1ea3360571a9f81ace6e6e7c2c8665:"
        }
      ]
    },
    {
      "id": "claim_f08cc8e6a64f40b79501ded88b8c02f9",
      "statement": "`src/lib/sanity/enriched.ts` defines enrichment as a derived GROQ predicate, `defined(guestPhoto.asset._ref) && length(guestBio) > 0`, so no stored boolean can drift away from the document's actual content.",
      "evidence": [
        {
          "resource": "repo://src/lib/sanity/enriched.test.ts#L33-L75",
          "version": "repo-lines-v1:sha256:8e7e7a6b1e4fafbaa5bfb7da12d7020cf7cb4a2600ddb6f6a88be9d0bc4e4fa5:"
