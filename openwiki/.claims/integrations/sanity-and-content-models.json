          "resource": "repo://src/lib/sanity/schema.contract.test.ts#L38-L96",
          "version": "repo-lines-v1:sha256:4389d0fd6b3296fb682f4612c880dfed832def12ef8afafdc4fa573d4e47bc87:"
        }
