    {
      "id": "claim_6eaad12238004cb2a274752c3f43b105",
      "statement": "`src/lib/sanity/publish.ts` implements publish safety with two compare-and-set checks in a single `mutate()` call: a slug lock document prevents two episodes from claiming the same slug, and a strict episode `create` prevents concurrent first publications of the same unpublished episode under different slugs.",
      "evidence": [
        {
          "resource": "repo://src/lib/sanity/publish.test.ts#L381-L467",
          "version": "repo-lines-v1:sha256:0bc5d9beaf0cbbe2a8f64ea7191f4db255291a14d65d433450c380bcb1228f5a:"
        },
        {
          "resource": "repo://src/lib/sanity/publish.ts#L1-L28",
          "version": "repo-lines-v1:sha256:c8c62804475401a79a3e7ccdbc6a009a4477b04c03efb8b99642415e2c11726f:"
        }
      ]
    },
    {
      "id": "claim_59769534ad91431a83f663248c4c3d3e",
      "statement": "The publish transaction treats first publish, replacement, and no-op as distinct outcomes, and seed mode deliberately avoids emitting an episode mutation against an existing document so rerunning backfill cannot overwrite enrichment or authored changes.",
      "evidence": [
        {
          "resource": "repo://src/lib/sanity/publish.test.ts#L341-L376",
          "version": "repo-lines-v1:sha256:885b09b556389bdcdb93e119732cc5632fc176f453882453f209f50d45f48b45:"
        },
        {
          "resource": "repo://src/lib/sanity/publish.test.ts#L471-L510",
