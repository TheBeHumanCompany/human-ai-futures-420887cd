        }
      ]
    },
    {
      "id": "claim_98e15faac2804c2793840f037b56196f",
      "statement": "The enrichment tests evaluate the real exported GROQ fragment with `groq-js`, which preserves GROQ truthiness and length semantics, including the documented whitespace-only bio edge case.",
      "evidence": [
        {
          "resource": "repo://src/lib/sanity/enriched.test.ts#L45-L75",
          "version": "repo-lines-v1:sha256:0d8e2fab742f080966f8e1be3ffb2d33f78bb2ba7b9b485bd5a57fd198728ad2:"
