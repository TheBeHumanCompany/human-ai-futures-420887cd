    },
    {
      "id": "claim_8497f5856d63448b9145bdc8471091d8",
      "statement": "The schema contract also pins important authoring invariants: `guid` is read-only, `slug` freezes only after publish, `searchText` is read-only, image fields require hotspot and alt text, and `topics` are references rather than free-text strings.",
      "evidence": [
