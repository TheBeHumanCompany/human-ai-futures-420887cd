    },
    {
      "id": "claim_5a7389b2c2044b2b91beca3ce0405241",
      "statement": "`src/lib/sanity/client-errors.ts` normalizes `@sanity/client` errors by duck-typing on numeric `statusCode` and re-wrapping them as `SanityHttpError`, leaving non-status errors untouched so publish arbitration can recognize real 409 conflicts across package boundaries.",
      "evidence": [
        {
          "resource": "repo://src/lib/sanity/client-errors.ts#L1-L42",
          "version": "repo-lines-v1:sha256:af873507b21064129a61a4cbc0e57fd64425504d1be3a7d8987a61c8ab20c9c4:"
        }
      ]
