    {
      "id": "claim_eb5f727926c34e0eb401aa121eccb5ff",
      "statement": "The schema contract tests tie the Studio schema back to the read projection by asserting both that required fields exist with the expected types and that every schema field is either projected or explicitly excluded with a reason, which turns Studio renames and additions into CI failures instead of silent content drift.",
      "evidence": [
        {
          "resource": "repo://src/lib/sanity/schema.contract.test.ts#L32-L149",
          "version": "repo-lines-v1:sha256:6e447a70dc35f4a1c7ed6fba3d8a807588f2ec66d65c321795ffe1447da48bed:"
