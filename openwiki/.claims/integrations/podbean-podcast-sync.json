        }
      ]
    },
    {
      "id": "claim_a36d777f5f2f424997b17657793049a5",
      "statement": "The parser is defensive: malformed or out-of-range entities, missing required fields, and non-plain-second durations are rejected or skipped so one bad item does not take down the whole catalogue.",
