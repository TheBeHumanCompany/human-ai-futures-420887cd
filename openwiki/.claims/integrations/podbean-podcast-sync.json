    {
      "id": "claim_88e3a2871fb34de59158c16f08ec7495",
      "statement": "The feed parser converts third-party RSS into display-safe episode data by decoding entities, stripping markup, excerpting show notes, extracting guests when possible, formatting durations, and selecting featured episodes.",
      "evidence": [
        {
          "resource": "repo://src/lib/podbean/parse.ts#L246-L260",
          "version": "repo-lines-v1:sha256:7e947e3671ae644eaaae5eceb6e61d7e23c84a734074181a12a6d7b017dea0d1:"
