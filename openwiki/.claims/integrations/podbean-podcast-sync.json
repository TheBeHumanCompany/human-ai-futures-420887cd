    {
      "id": "claim_bdf3fed9daf544cea7b53e604c6e03e1",
      "statement": "`loadEpisodes()` fetches the public feed with an XML-oriented Accept header and an 8 second timeout, parses it, caches the last good result for 15 minutes, and serves stale cached episodes on fetch, HTTP, or parse failure instead of throwing.",
      "evidence": [
        {
          "resource": "repo://src/lib/podbean/feed.ts#L25-L103",
          "version": "repo-lines-v1:sha256:21fc939113a2437b4d9460783258eb092223f9fa4f6d8eb7f3b0a5b9ed269112:"
        }
      ]
    },
    {
      "id": "claim_4026f1b161434a2787bba97258f8adff",
      "statement": "`getEpisodes` is a server function that keeps feed fetching and XML parsing on the server and returns browsable listing items to routes.",
      "evidence": [
        {
          "resource": "repo://src/lib/podbean/feed.ts#L105-L110",
