    {
      "id": "claim_3e328a0e11c74b029f1bbadb83a0203e",
      "statement": "The browse model is intentionally small and client-side: it supports search, duration buckets, and sort order, applies AND semantics across search terms, matches accent-insensitively across title, guest, excerpt, and episode number, and never mutates the input array.",
