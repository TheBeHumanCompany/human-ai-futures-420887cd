# Copy to `.env.local` and fill in. `.env.local` is gitignored (`*.local`).
#
# There are only two variables in this project, and that is deliberate. The
# read path needs no credential at all — public reads run against Sanity's
# published perspective with no Authorization header (AC-11) — so the project
# id, dataset, API version and canonical origin live in
# `src/lib/sanity/config.ts` as constants rather than as environment. The
# canonical origin in particular must not be per-deploy configurable: every
# permanent episode URL is absolute against it, and a preview deploy quietly
# minting links on a different host is the failure this project exists to
# prevent.

# Write token for the seeding and publish scripts ONLY.
#
# Used by `scripts/backfill.ts` and the Studio publish action. Never read by
# anything in the deployed request path. Needs Editor permissions on the
# `production` dataset. Sanity tokens cannot be scoped narrowly enough to make
# this safe by configuration alone, so treat it as a credential that can
# rewrite the archive: keep it out of the repo, out of the build, and rotate it
# if it is ever pasted anywhere.
SANITY_WRITE_TOKEN=

# Set to any non-empty value to run the live-network tests.
#
# Unset (the default) the live suites are skipped via `describe.skipIf`, which
# is what keeps PodBean's and Sanity's uptime off the pull-request gate. The
# nightly workflow sets it. Locally: `bun run test:live`.
RUN_LIVE_TESTS=

# Resend API key for the contact form (src/lib/contact.ts).
#
# The form delivers over Resend's HTTP API (the deploy target cannot open
# outbound SMTP). Set the same key in the hosting provider's environment.
#
# Resend must ALSO have the sending domain verified at resend.com/domains
# before the from-address may send — until then the API returns 403 and an
# unverified account can only mail its own owner. The sending domain is the
# subdomain `updates.thebehumancompany.ca`, so the apex keeps its Google
# Workspace MX and its own SPF untouched.
#
# Unset, the form does not pretend to work: it tells the visitor to email
# info@thebehumancompany.ca directly.
RESEND_API_KEY=

# Supabase Postgres token store for the client portal
# (docs/client-portal-tokens.md, migration under supabase/migrations/).
#
# SUPABASE_URL is the project REST base, e.g. https://xyzcompany.supabase.co.
# SUPABASE_SERVICE_ROLE_KEY is read server-side ONLY (the token server
# function via src/lib/client-portal/supabase-tokens.ts) — it bypasses RLS
# and must never reach the client bundle or the repo. Set both values in the
# hosting provider's environment as well as in `.env.local`.
# SUPABASE_ANON_KEY is NOT read by the site; it exists here only for the
# manual RLS probe documented in the notes (anon reads must return no rows).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Optional override for the contact form's from-address (src/lib/contact.ts).
#
# Defaults to `The Be Human Company <website@updates.thebehumancompany.ca>`,
# which needs that subdomain verified in Resend. Set to `The Be Human Company <onboarding@resend.dev>` to
# exercise the path before verification — that sender only reaches the Resend
# account owner, so it proves delivery without being useful for real enquiries.
RESEND_FROM=

# Stripe one-time audit checkout (docs/billing-stripe.md).
#
# SECRET is server-side ONLY (checkout session create, webhook fulfillment
# release) — it must never reach the client bundle or the repo; the build
# greps verify this. PUBLISHABLE is client-safe but currently unused (no
# embedded Stripe.js; Checkout is hosted). AUDIT_PRICE_ID names the test-mode
# Price for the audit fee — the amount lives in Stripe, never in code.
# WEBHOOK_SECRET comes from `stripe listen` in dev and the dashboard in prod;
# without it /api/stripe-webhook answers 500 rather than unverified 200s.
# Set all four in the hosting provider's environment as well as `.env.local`.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_AUDIT_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
