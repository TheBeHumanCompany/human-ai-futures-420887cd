# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Vercel
.vercel

# OMC agent runtime state
.omc

# Codex CLI runtime state — session logs, sqlite (+ its WAL/SHM siblings) and
# generated skill scaffolding. Same class as .omc and .omx, all three of which
# scripts/verify/audit-coverage.sh already skips as agent tooling.
.codex

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Playwright run artifacts
test-results/
playwright-report/
e2e-results.json

# Env files. `vercel link` appended the `.env*` line; the negation is ours —
# `.env.example` is documentation the project depends on and must stay visible,
# and a blanket `.env*` would swallow it on any file that is not already tracked.
.env*
!.env.example
