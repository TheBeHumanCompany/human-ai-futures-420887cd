{
  // The one-way-write code typechecks under its own project, not the root one.
  //
  // v3 of the plan proposed adding `scripts/**/*.ts` to the root `include`.
  // That would fail on the first CI run: these scripts use `process.env` and
  // `process.argv`, and while `@types/node` is installed it is deliberately
  // absent from the root `types` (which is `["vite/client"]`). Widening the
  // root project would mean either polluting the app's ambient types with Node
  // globals or leaving the scripts unchecked. A second project costs one file
  // and keeps both boundaries honest — this is R5 in the consensus plan.
  "extends": "../tsconfig.json",
  "include": ["**/*.ts"],
  // Same exclusion, and the same reason, as the root project: tests run under
  // Bun's own runtime, which supplies `bun:test` and the `Bun` global.
  // Typechecking them here would need the bun-types package, and `bunfig.toml`
  // enforces a 24h minimumReleaseAge on new packages. Excluding keeps
  // `tsc -p scripts --noEmit` meaningful for the shipped scripts without
  // adding a dependency to satisfy a type-only need.
  "exclude": ["**/*.test.ts"],
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true
  }
}
