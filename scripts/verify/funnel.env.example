# Funnel smoke-suite environment contract (todo 3 tier).
#
# Copy the values you need into your shell (never commit real values):
#   set -a; source .env.local; set +a   # .env.local already carries the trio
#   export FUNNEL_RUN_ID=fw1-$(git rev-parse --short HEAD)
#   export FUNNEL_TEST_EMAIL=you+funnel@example.test
#
# Consumed by: scripts/verify/funnel-seed.ts, scripts/verify/funnel-reset.ts,
# and (from todo 4) scripts/verify/funnel.sh preflight + the funnel Playwright
# project. Secret values are masked to their prefix in every funnel log.

# --- Funnel tier (this suite) --------------------------------------------

# Path to the isolated client store the funnel run reads instead of
# content/clients.json. Absolute, or relative to the repo root. Default:
# e2e/funnel/fixtures/clients.json (seed scripts) — the APP seam has no
# default: unset means the app reads content/clients.json exactly as before.
FUNNEL_STORE_PATH=e2e/funnel/fixtures/clients.json

# Run scope stamp. REQUIRED for seed and reset; every funnel log line carries
# it and each seeded section body records it, so a run's rows are auditable.
# One value per run: FUNNEL_RUN_ID=fw1-<short-sha>.
FUNNEL_RUN_ID=fw1-0000000

# The controlled inbox the suite signs up/signs in with on the dev Clerk
# instance (stage 4). Required by seed (recorded on the fixture client's log
# line) and by the Clerk sign-in helper.
FUNNEL_TEST_EMAIL=funnel-test@example.test

# Directory where the dev server's intercepted Resend send bodies are written
# in the deterministic tier (no real email). The magic-link email seam (todo
# 12) reads its base-URL override from this; unset means real Resend sends.
FUNNEL_EMAIL_CATCHER_DIR=

# Live-tier gates. Both unset/empty in the default deterministic run. FUNNEL_LIVE=1
# allows one real Resend delivery to FUNNEL_TEST_EMAIL; GTM_RUN_LIVE=1 runs the
# real `gtm validate` against the LangGraph server (existing podcasts flag).
FUNNEL_LIVE=
GTM_RUN_LIVE=

# --- Supabase trio (pre-existing dev project; seed/reset + app reads) -----

# Project REST base, no trailing slash.
SUPABASE_URL=https://your-project.supabase.co
# Service-role key. Bypasses RLS: seed/reset writes only. Never logged, never
# bundled, never committed.
SUPABASE_SERVICE_ROLE_KEY=
# Public anon key. Used by the seed's bucket probe to PROVE anonymous reads
# of the upload bucket are denied. Never secret; still never committed.
SUPABASE_ANON_KEY=

# --- Clerk dev instance (pre-existing) -------------------------------------

VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Stripe TEST mode (pre-existing) ----------------------------------------

# sk_test_ key. The preflight (todo 4) asserts the prefix; live-mode keys are
# forbidden anywhere in the funnel.
STRIPE_SECRET_KEY=

# The audit price the funnel checkout buys. A persistent TEST-mode price,
# created ONCE (dashboard, or `stripe prices create` with the test key) and
# then reused by every run — the preflight asserts its presence, it is never
# created per-run.
STRIPE_AUDIT_PRICE_ID=price_test_placeholder

# Upload storage bucket seeded by funnel-seed.ts (created when absent,
# private, anon-denied by verified probe). Code-level constant today — the
# upload intake (todo 10) writes to this same bucket name.
#   UPLOAD_BUCKET = "client-uploads"
